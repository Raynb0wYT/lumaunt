<UserControl x:Class="Lumaunt.Windows.TrayPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="270" FontFamily="Segoe UI" FontSize="13">
  <StackPanel>
    <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
      <Image Source="Assets/Lumaunt.png" Width="18" Height="18" Margin="0,0,8,0" />
      <TextBlock Text="Lumaunt" FontWeight="SemiBold" VerticalAlignment="Center" />
    </StackPanel>
    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,7,0,10" />
    <Grid x:Name="ProfileRow" Margin="0,0,0,10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Grid Width="32" Height="32" HorizontalAlignment="Left">
        <Border Background="{DynamicResource PreviewBrush}" CornerRadius="16"><TextBlock x:Name="AvatarPlaceholder" Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <Image x:Name="Avatar" Width="32" Height="32"><Image.Clip><EllipseGeometry Center="16,16" RadiusX="16" RadiusY="16"/></Image.Clip></Image>
      </Grid>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0"><TextBlock x:Name="DisplayName" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="Username" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="7" Height="7" Fill="#32CE68" Margin="0,0,5,0"/><TextBlock Text="Connected" Style="{StaticResource Caption}" FontSize="10"/></StackPanel>
    </Grid>
    <TextBlock x:Name="ConnectionState" Style="{StaticResource Caption}" Margin="0,0,0,10"/>
    <TextBlock Text="Presence" Style="{StaticResource Caption}" Margin="0,0,0,5"/>
    <StackPanel Orientation="Horizontal"><Ellipse x:Name="PresenceDot" Width="7" Height="7" Margin="0,0,7,0"/><TextBlock x:Name="PresenceState" FontWeight="SemiBold"/></StackPanel>
    <TextBlock x:Name="Details" Style="{StaticResource Caption}" Margin="14,5,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
    <TextBlock x:Name="State" Style="{StaticResource Caption}" Margin="14,3,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
  </StackPanel>
</UserControl>
